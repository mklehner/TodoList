@using Web.Frontend.Models
@model IEnumerable<Web.Frontend.Models.BewerbungViewModel>

@{
    ViewData["Title"] = "🛠️ Bewerbungen";
}

<style>
    body { background-color: #121212 !important; color: #ffffff !important; }
    .tree-indent { margin-left: 2.5rem; border-left: 2px dashed #444; padding-left: 1rem; }
</style>

<!--div class="text-center mt-5">
    <h1 class="display-4">Meine Bewerbung.</h1>
    <p>Hier hinterlege ich Stellenzeigen und meine Bewerbungsdetails, einschl. Anschreiben und Lebenslauf.</p>
</div-->

<div class="container mt-3" style="max-width: 850px;">

    <!-- Haupt-Formular für neue WURZEL-Aufgaben -->
    <div class="card p-3 pt-2 pb-1 shadow-sm mb-3 bg-secondary text-white border-secondary">
        <!-- h5>Neue Stellenanzeige erfassen</h5 -->
        <form asp-action="Create" method="post">
            <input type="hidden" name="Id" value="" />

            <!-- Freelance Checkbox (rechtsbündigbündig neben dem Titel) -->
            <div class="row g-2 mb-1 align-items-center">
                <div class="col-auto col-7>
                    <label class="form-check-label large text-white">Neue Stellenanzeige erfassen</label>
                </div>
                <div class="col-md-2 ms-auto">
                    <div class="form-check m-0 d-flex align-items-center" style="min-height: 31px;">
                        <input type="checkbox" name="freelance" id="freelance" class="form-check-input bg-dark border-secondary me-2" value="true" />
                        <label class="form-check-label small text-white-50" for="freelance">Freelance</label>
                    </div>
                </div>
            </div>

            <!-- Job Titel -->
            <div class="row g-2 mb-2">
                <div class="col-md-8">
                    <label class="form-label small text-white-50 m-0">Stelle</label>
                    <input type="text" name="jobTitle" class="form-control form-control-sm bg-dark text-white" placeholder="Job Titel..." required />
                </div>

                <!-- Status -->
                <!--div class="col-md-1"><label class="form-label small text-white-50 m-0">Status</label></div-->
                <div class="col-md-2">
                    <label class="form-label small text-white-50 m-0">Status</label>
                    <select name="status" class="form-control form-control-sm bg-dark text-white">
                        <option value="Offen" selected>Offen</option>
                        <option value="Eingereicht">Eingereicht</option>
                        <option value="Geschlossen">Geschlossen</option>
                        <option value="Gespräch">Gespräch</option>
                        <option value="Zusage">Zusage</option>
                        <option value="Absage">Absage</option>
                    </select>
                </div>
                <!--div class="col-md-2">
                    <label class="form-label small text-white-50 m-0">Bewerbungsdatum</label>
                    <input type="date" name="BewerbungsDatum" class="form-control form-control-sm bg-dark text-white"/>
                </div-->
                <div class="col-md-2 col-3">
                    <label class="form-label small text-white-50 m-0">BatchId</label>
                    <input type="number" name="batchId" class="form-control form-control-sm bg-dark text-white" min="0" placeholder="BatchId..." required />
                </div>

                <div class="col-md-8">
                    <label class="form-label small text-white-50 m-0">Unternehmen</label>
                    <input type="text" name="unternehmen" class="form-control form-control-sm bg-dark text-white" placeholder="Firma..." required />
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-white-50 m-0">Match (Prio)</label>
                    <select name="priority" class="form-control form-control-sm bg-dark text-white">
                        <option value="LowMatch">Low Match</option>
                        <option value="Normal" selected>Normal</option>
                        <option value="HighMatch">High Match</option>
                        <option value="Special">Special</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small text-white-50 m-0">Bw.-Frist</label>
                    <input type="date" name="dueDate" class="form-control form-control-sm bg-dark text-white" placeholder="Frist..."/>
                </div>
            </div>

            <div class="row g-2 mb-2">
                @* <div class="col-md-2 col-3">
                    <label class="form-label small text-white-50 m-0">BatchId</label>
                    <input type="number" name="batchId" class="form-control form-control-sm bg-dark text-white" min="0" placeholder="BatchId..." required />
                </div> *@
                <div class="col-md-8 col-16">
                    <label class="form-label small text-white-50 m-0">💬Notizen</label>
                    <textarea name="notes" class="form-control form-control-sm bg-dark text-white" rows="1" placeholder="Optionale Notizen hinzufügen..."></textarea>
                </div>
                <div class="col-md-4 col-8">
                    <label class="form-label small text-white-50 m-0">Kontakt</label>
                    <input type="text" name="kontakt" class="form-control form-control-sm bg-dark text-white" placeholder="Kontakt Info..."/>
                </div>
            </div>

            <div class="row g-2">
                <div class="col-md-12">
                    <details>
                        <summary class="form-label small text-white-50 role="button" style="cursor: pointer;">Stellenbeschreibung...</summary>
                        <textarea type="text" name="description" class="form-control bg-dark text-white border-secondary" rows="10" placeholder="Stellenbeschreibung..." ></textarea>
                    </details>                
                </div>
            </div>

            <div class="row g-2">
                <div class="col-md-12">
                    <details>
                        <summary class="form-label small text-white-50 role="button" style="cursor: pointer;">Anschreiben...</summary>
                        <textarea type="text" name="anschreiben" class="form-control bg-dark text-white border-secondary" rows="10" placeholder="Anschreiben..." ></textarea>
                    </details>
                </div>
            </div>

            <div class="col-md-12">
                <details>
                    <summary class="form-label small text-white-50 role="button" style="cursor: pointer;">Lebenslauf...</summary>
                    <input type="text" name="lebenslauf" class="form-control form-control-sm bg-dark text-white" rows="10" placeholder="Lebenslauf..." >
                </details>
            </div>

            <div class="row g-2 align-items-center pt-2 pb-1">
                
                <div class="col-md-2">
                    <label class="form-label small text-white-50 m-0">Bewerbungsdatum:</label>
                </div>
                <div class="col-md-2">
                    <input type="date" name="BewerbungsDatum" class="form-control form-control-sm bg-dark text-white"/>
                </div>

                <div class="col-auto ms-auto">
                    <button type="submit" class="btn btn-sm btn-success px-3">Erstellen</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Liste der Hauptitems (ruft für jede Zeile die Partial View auf) -->
    <ul class="list-group shadow-sm border-secondary">
        @if (!Model.Any())
        {
            <li class="list-group-item text-center text-muted py-4 bg-dark border-secondary">Keine Bw's vorhanden.</li>
        }
        @foreach (var rootItem in Model.OrderBy(t => t.BatchId))
        {
            <!-- Hier übergeben wir ein Tuple mit dem Item und dem aktuellen Einrückungslevel (0) -->
            @await Html.PartialAsync("_BewerbungNode", (item: rootItem, depth: 0))
        }
    </ul>

</div>