@using Web.Frontend.Models
@model (TodoViewModel item, int depth)

@{
    var heute = DateTime.Today;
    var item = Model.item;
    var depth = Model.depth;
    int? editId = ViewData["EditId"] as int?;

    bool istUeberfaellig = !item.IsCompleted && item.DueDate.HasValue && item.DueDate.Value.Date < heute;

    string prioBadge = item.Priority == "Hoch" ? "border border-danger text-danger bg-transparent" : item.Priority == "Mittel" 
            ? "border border-warning text-warning bg-transparent" 
            : "border border-secondary text-secondary bg-transparent";

    string listenKlasse = istUeberfaellig ? "bg-danger bg-opacity-25 text-white border-danger" : "bg-dark text-white border-secondary";
    
    bool hatKinder = item.SubTodos != null && item.SubTodos.Any();
    bool istImEditModus = editId.HasValue && editId.Value == item.Id;
}

<style>
    .todo-node-container {
        /* 🔴 Die Breite des Aufklapp-Buttons (+/-) */
        --toggle-width: 2rem;
        display: block;
        width: 100%;
        position: relative;
    }

    summary.todo-summary, .todo-flat-item {
        display: block;
        outline: none;
        position: relative;
        padding-left: var(--toggle-width) !important;
    }
    
    summary.todo-summary {
        cursor: pointer;
    }

    summary.todo-summary::marker,
    summary.todo-summary::-webkit-details-marker {
        display: none !important;
    }

    /* Die Quadratische Box skaliert nun relativ mit (em) */
    summary.todo-summary::before, .todo-flat-item::before {
        content: "+";
        position: absolute;
        left: 0.25rem;
        top: 50%;
        transform: translateY(-50%);
        width: 1.15em;
        height: 1.15em;
        border: 2px solid #6c757d;
        border-radius: 0.25rem;
        background-color: #2b3035;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        font-weight: bold;
        font-size: 0.85em;
        font-family: monospace;
        line-height: 1;
        transition: all 0.15s ease-in-out;
    }

    /* Standard-Inhalt für Eltern (wird beim Öffnen zu Minus) */
    summary.todo-summary::before {
        content: "+";
    }

    /* 🔴 Fester Inhalt für kinderlose Items */
    .todo-flat-item::before {
        content: "x";
    }

    summary.todo-summary:hover::before {
        border-color: #f8f9fa;
        color: #f8f9fa;
        background-color: #343a40;
    }

    details[open] > summary.todo-summary::before {
        content: "−";
        border-color: #495057;
        color: #6c757d;        
    }
    
    /* 🔴 Hier steuern wir nun das Einrücken der Unterelemente */
    .todo-sub-items {
        padding-left: 3.0rem; //var(--toggle-width);
        position: relative;
        width: 100%;
    }

    /* Die gestrichelte Führungslinie orientiert sich an der CSS-Variable */
    .todo-sub-items::before {
        content: "";
        position: absolute;
        left: 2rem; //calc(var(--toggle-width) / 2.5);
        top: 0;
        bottom: 14px;
        border-left: 2px dashed #495057;
    }
</style>

<div class="todo-node-container mt-1">
    @if (hatKinder)
    {
        @* 🔴 WICHTIG: data-todo-id hinzugefügt und id="details-..." für den localStorage-Key *@
        <details class="w-100 m-0 p-0 todo-details-node" id="details-@item.Id" data-todo-id="@item.Id">
            @if (istImEditModus)
            {
                <summary class="todo-summary p-0 m-0">
                    @await Html.PartialAsync("_TodoEditForm", item)
                </summary>
            }
            else
            {
                <summary class="todo-summary m-0 p-0">
                    @await Html.PartialAsync("_TodoDisplayItem", Tuple.Create(item, listenKlasse, prioBadge, hatKinder, depth))
                </summary>
            }

            <div class="todo-sub-items">
                @foreach (var subItem in item.SubTodos!.OrderBy(s => s.BatchId))
                {
                    @await Html.PartialAsync("_TodoNode", (item: subItem, depth: depth + 1))
                }
            </div>
        </details>
    }
    else
    {
        /* 🔴 Wir packen das Element ohne Kinder in einen CSS-Klasse-Container */
        <div class="todo-flat-item">
            @if (istImEditModus)
            {
                @await Html.PartialAsync("_TodoEditForm", item)
            }
            else
            {
                @await Html.PartialAsync("_TodoDisplayItem", Tuple.Create(item, listenKlasse, prioBadge, hatKinder, depth))
            }
        </div>
    }
</div>

<script>
    // Verhindert, dass das Skript mehrfach registriert wird, falls die Node rekursiv geladen wird
    if (typeof window.todoScriptLoaded === 'undefined') {
        window.todoScriptLoaded = true;

        document.addEventListener("DOMContentLoaded", function () {
            // 1. Zustand beim Laden der Seite für alle Klapp-Elemente wiederherstellen
            document.querySelectorAll('.todo-details-node').forEach(details => {
                const todoId = details.getAttribute('data-todo-id');
                const savedState = localStorage.getItem('todo_open_' + todoId);

                if (savedState !== null) {
                    if (savedState === 'true') {
                        details.setAttribute('open', '');
                    } else {
                        details.removeAttribute('open');
                    }
                } else {
                    // Standardmäßig offen, wenn noch nichts im Speicher liegt
                    details.setAttribute('open', '');
                }

                // 2. Klicks abfangen und den aktuellen Zustand (true/false) speichern
                details.addEventListener('toggle', function () {
                    localStorage.setItem('todo_open_' + todoId, details.open);
                });
            });
        });
    }
</script>


