@using Web.Frontend.Models
@model Tuple<TodoViewModel, string, string, bool, int>

@{
    var item = Model.Item1;
    var listenKlasse = Model.Item2;
    var prioBadge = Model.Item3;
    var hatKinder = Model.Item4;
}

<li id="todo-@item.Id" class="list-group-item d-flex justify-content-between align-items-center @listenKlasse rounded w-100 @(hatKinder ? "d-inline-flex" : "")">
    <div class="text-truncate me-3" style="flex: 1;">
        <span class="badge bg-dark border border-secondary text-muted me-1" style="font-size: 0.7rem;">#@item.BatchId</span>
        <span class="badge @prioBadge me-2" style="font-size: 0.7rem;">@item.Priority</span>
        <span class="fw-bold" style="@(item.IsCompleted ? "text-decoration: line-through; color: #888888;" : "")">@item.Title</span>
        @if (item.DueDate.HasValue)
        {
            <span class="badge @(listenKlasse.Contains("bg-danger") ? "bg-danger" : "bg-secondary") ms-2">@item.DueDate.Value.ToString("dd.MM.yyyy")</span>
        }
        @if (!string.IsNullOrEmpty(item.Notes))
        {
            <div class="small mt-1 text-muted" style="white-space: pre-line;">💬&nbsp; @item.Notes</div>
        }
    </div>
    
    <div class="d-flex gap-1 flex-shrink-0" onclick="event.stopPropagation();">
        <button class="btn btn-sm btn-outline-success" onclick="let t=prompt('Name der Unteraufgabe:'); if(t){ location.href='/Product/Create?title='+encodeURIComponent(t)+'&priority=Mittel&parentId='+@item.Id; }">+</button>
        <a asp-action="Index" asp-route-editId="@item.Id" asp-fragment="todo-@item.Id" class="btn btn-sm btn-outline-info">Edit</a>
        <form asp-action="Toggle" method="post" class="m-0"><input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-sm btn-primary">✓</button></form>
        <form asp-action="Delete" method="post" class="m-0"><input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-sm btn-secondary">X</button></form>
    </div>
</li>

