@model IEnumerable<Web.Frontend.Models.TodoViewModel>

@{
    ViewData["Title"] = "Meine To-Do Liste";
    var heute = DateTime.Today;
}

<style>
    body { background-color: #121212 !important; color: #ffffff !important; }
    .tree-indent { margin-left: 2.5rem; border-left: 2px dashed #444; padding-left: 1rem; }
</style>

<div class="container mt-5" style="max-width: 850px;">
    <h2 class="text-center mb-4 text-muted">🛠️ Todo Liste (hierarchisch)</h2>
    
    <!-- Haupt-Formular für neue WURZEL-Aufgaben -->
    <div class="card p-3 shadow-sm mb-4 bg-secondary text-white border-secondary">
        <h5>Neue Hauptaufgabe erstellen</h5>
        <form asp-action="Create" method="post">
            <input type="hidden" name="parentId" value="" />
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <input type="text" name="title" class="form-control bg-dark text-white border-secondary" placeholder="Hauptaufgabe..." required />
                </div>
                <div class="col-md-3">
                    <input type="date" name="dueDate" class="form-control bg-dark text-white border-secondary" />
                </div>
                <div class="col-md-3">
                    <select name="priority" class="form-select bg-dark text-white border-secondary">
                        <option value="Niedrig">Prio: Niedrig</option>
                        <option value="Mittel" selected>Prio: Mittel</option>
                        <option value="Hoch">Prio: Hoch</option>
                    </select>
                </div>
            </div>
            <div class="row g-2">
                <div class="col-md-10">
                    <input type="text" name="notes" class="form-control bg-dark text-white border-secondary" placeholder="Details..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">Erstellen</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Filterleiste -->
    <div class="card p-2 shadow-sm mb-3 bg-dark border-secondary">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="search" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Suchen..." value="@ViewData["CurrentSearch"]" />
            </div>
            <div class="col-md-4">
                <select name="priorityFilter" class="form-select form-select-sm bg-dark text-white border-secondary">
                    <option value="Alle" selected="@(ViewData["CurrentPriorityFilter"]?.ToString() == "Alle")">Alle Prioritäten</option>
                    <option value="Hoch" selected="@(ViewData["CurrentPriorityFilter"]?.ToString() == "Hoch")">Nur Hoch</option>
                    <option value="Mittel" selected="@(ViewData["CurrentPriorityFilter"]?.ToString() == "Mittel")">Nur Mittel</option>
                    <option value="Niedrig" selected="@(ViewData["CurrentPriorityFilter"]?.ToString() == "Niedrig")">Nur Niedrig</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-info w-100 text-dark">Filtern</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-light">X</a>
            </div>
        </form>
    </div>

    <!-- Liste der Hauptaufgaben (ruft für jede Zeile die Partial View auf) -->
    <ul class="list-group shadow-sm border-secondary">
        @if (!Model.Any())
        {
            <li class="list-group-item text-center text-muted py-4 bg-dark border-secondary">Keine Aufgaben vorhanden.</li>
        }
        @foreach (var rootItem in Model)
        {
            <!-- Hier übergeben wir ein Tuple mit dem Item und dem aktuellen Einrückungslevel (0) -->
            @await Html.PartialAsync("_TodoNode", (item: rootItem, depth: 0))
        }
    </ul>
</div>

