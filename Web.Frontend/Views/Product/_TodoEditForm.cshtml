@model Web.Frontend.Models.TodoViewModel

<li id="todo-@Model.Id" class="list-group-item bg-secondary p-3 border-info rounded w-100">
    <form asp-action="Edit" asp-fragment="todo-@Model.Id" method="post" class="w-100">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="isCompleted" value="@Model.IsCompleted.ToString().ToLower()" />
        
        <div class="row g-2 mb-2">
            <div class="col-md-6 col-12">
                <label class="form-label small text-white-50 m-0">Aufgabe</label>
                <input type="text" name="title" class="form-control form-control-sm bg-dark text-white" value="@Model.Title" required />
            </div>
            <div class="col-md-3 col-6">
                <label class="form-label small text-white-50 m-0">Fälligkeit</label>
                <input type="date" name="dueDate" class="form-control form-control-sm bg-dark text-white" value="@(Model.DueDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3 col-6">
                <label class="form-label small text-white-50 m-0">Priorität</label>
                <select name="priority" class="form-select form-select-sm bg-dark text-white">
                    <option value="Niedrig" selected="@(Model.Priority == "Niedrig")">Niedrig</option>
                    <option value="Mittel" selected="@(Model.Priority == "Mittel")">Mittel</option>
                    <option value="Hoch" selected="@(Model.Priority == "Hoch")">Hoch</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small text-white-50 m-0">Notizen</label>
            <textarea name="notes" class="form-control form-control-sm bg-dark text-white" rows="2" placeholder="Optionale Notizen hinzufügen...">@Model.Notes</textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <label class="form-label small text-white-50 m-0">BatchId</label>
            <input type="number" name="BatchId" class="form-control form-control-sm bg-dark text-white" id="BatchId-@Model.Id" value="@Model.BatchId" min="0" required />

            <a asp-action="Index" asp-fragment="todo-@Model.Id" class="btn btn-sm btn-light px-3">Abbrechen</a>
            <button type="submit" class="btn btn-sm btn-success px-3">Speichern</button>
        </div>
    </form>
</li>

